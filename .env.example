# Renomeie este arquivo para ".env" (opcional - veja abaixo).
PORT=3000

# JEITO MAIS SIMPLES (recomendado): nao precisa mexer neste arquivo.
# Basta colocar o arquivo baixado do Firebase com o nome exato
# "serviceAccountKey.json" dentro desta pasta (backend/), do lado do
# package.json. O backend encontra ele automaticamente.

# Alternativa 1: apontar para o arquivo em outro caminho/nome
# GOOGLE_APPLICATION_CREDENTIALS=./serviceAccountKey.json

# Alternativa 2: colar o conteudo do JSON da service account em uma unica linha
# FIREBASE_SERVICE_ACCOUNT_JSON={"type":"service_account", ...}

# Necessario apenas para a pre-triagem por IA (aba "Agendar consulta" do paciente).
# Gere uma chave gratuita em https://aistudio.google.com/apikey.
GEMINI_API_KEY=
